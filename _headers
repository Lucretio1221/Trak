# Netlify citește acest fișier direct din rădăcina publicată.
# Text simplu, fără build step, fără dependințe.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

# Fonturile nu se schimbă niciodată la același nume de fișier.
# Dacă vreodată înlocuiești un .woff2, redenumește-l — altfel cache-ul
# de un an îl va servi pe cel vechi.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=604800

/assets/favicon.svg
  Cache-Control: public, max-age=604800

# styles.css NU are hash în nume, deci nu poate fi cache-uit agresiv:
# o oră, ca o corectură de design să ajungă repede la vizitatori.
/assets/styles.css
  Cache-Control: public, max-age=3600

# Politica de securitate a conținutului. Site-ul nu are JavaScript și nu
# încarcă nimic de pe alt domeniu, deci poate fi cât se poate de strictă.
# Lăsată comentată intenționat: JSON-LD (`application/ld+json`) e un bloc
# de date, nu script executabil, și în mod normal nu e blocat de
# `script-src` — dar nu am putut verifica asta pe un domeniu real de aici.
# Activeaz-o după primul deploy și confirmă în Google Rich Results Test
# că Person-ul de pe home e în continuare citit.
# /*
#   Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
